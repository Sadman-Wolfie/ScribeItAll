{
  "manifest_version": 3,
  "name": "ScribeItAll",
  "version": "1.0",
  "description": "Extracts readable content and saves it as a Markdown file for studying.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/favicon-1.png",
    "32": "icons/favicon-2.png",
    "48": "icons/favicon-3.png",
    "128": "icons/favicon-4.png"
  },
  "action": {
    "default_title": "Extract to Markdown"
  },
  "commands": {
    "transmute_page": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Transmute active page to Grimoire Markdown"
    }
  },
  "options_page": "options.html"
}